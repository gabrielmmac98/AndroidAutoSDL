--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/sdl/SdlReceiverContext.kt
@@ -0,0 +1,33 @@
+package com.andrerinas.openheadunit.sdl
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.ContextWrapper
+import android.content.Intent
+import android.content.IntentFilter
+import android.os.Build
+import android.os.Handler
+
+/** Adapts the legacy SDL SDK's internal receivers to current Android registration rules. */
+internal class SdlReceiverContext(base: Context) : ContextWrapper(base) {
+    override fun getApplicationContext(): Context = this
+
+    override fun registerReceiver(receiver: BroadcastReceiver?, filter: IntentFilter): Intent? =
+        if (Build.VERSION.SDK_INT >= 33) {
+            super.registerReceiver(receiver, filter, Context.RECEIVER_NOT_EXPORTED)
+        } else {
+            super.registerReceiver(receiver, filter)
+        }
+
+    override fun registerReceiver(
+        receiver: BroadcastReceiver?,
+        filter: IntentFilter,
+        broadcastPermission: String?,
+        scheduler: Handler?
+    ): Intent? =
+        if (Build.VERSION.SDK_INT >= 33) {
+            super.registerReceiver(receiver, filter, broadcastPermission, scheduler, Context.RECEIVER_NOT_EXPORTED)
+        } else {
+            super.registerReceiver(receiver, filter, broadcastPermission, scheduler)
+        }
+}
