@@ -0,0 +1,39 @@
+package com.andrerinas.openheadunit.sdl
+import android.app.Activity
+import android.os.Bundle
+import android.content.Intent
+import android.util.Log
+import com.andrerinas.openheadunit.App
+import com.andrerinas.openheadunit.utils.HeadUnitScreenConfig
+class SdlProfileSelfTestActivity: Activity(){
+ override fun onCreate(state:Bundle?){super.onCreate(state)
+  check(SdlPlaybackPolicy.autoStart(true,true,false,false,false,false))
+  check(!SdlPlaybackPolicy.autoStart(true,false,false,false,false,false))
+  check(!SdlPlaybackPolicy.autoStart(true,true,false,false,true,false))
+  check(!SdlPlaybackPolicy.autoStart(true,true,false,false,false,true))
+  check(!SdlPlaybackPolicy.autoStart(false,true,false,false,false,false))
+  check(!SdlPlaybackPolicy.autoStart(true,true,true,false,false,false))
+  check(!SdlPlaybackPolicy.autoStart(true,true,false,true,false,false))
+  Log.i("SDL_PLAYBACK_TEST","PASS auto-start gates: authorization, preference, manual stop, once per session, connected, starting")
+  val settings=App.provide(this).settings
+  val priorDpi=settings.dpiPixelDensity;val priorResolution=settings.resolutionId
+  try {
+   SdlSessionProfile.aspectCorrectionE4=10000
+   SdlSessionProfile.active=true;SdlSessionProfile.panelWidth=800;SdlSessionProfile.panelHeight=480
+   for(dpi in listOf(160,200)) {
+    SdlSessionProfile.dpi=dpi
+    val g=HeadUnitScreenConfig.announceGeometry(Any(),this,resources.displayMetrics,settings)
+    check(g.width==800 && g.height==480 && g.pixelAspectRatioE4==10000)
+    check(g.densityDecision.announced==dpi && g.widthMargin==0 && g.heightMargin==0)
+    check(HeadUnitScreenConfig.getNegotiatedWidth()==800 && HeadUnitScreenConfig.getNegotiatedHeight()==480)
+   }
+   SdlSessionProfile.aspectCorrectionE4=10670
+   val wide=HeadUnitScreenConfig.announceGeometry(Any(),this,resources.displayMetrics,settings)
+   check(wide.width==800 && wide.height==480 && wide.pixelAspectRatioE4==10670)
+   SdlSessionProfile.aspectCorrectionE4=10000
+   check(priorDpi==settings.dpiPixelDensity && priorResolution==settings.resolutionId)
+   Log.i("SDL_PROFILE_TEST","PASS 800x480; PAR 10000/10670; DPI 160/200; normal preferences preserved")
+  }catch(e:Throwable){Log.e("SDL_PROFILE_TEST","FAIL",e)}finally{SdlSessionProfile.active=false;SdlSessionProfile.dpi=160;SdlSessionProfile.aspectCorrectionE4=10000}
+  startActivity(Intent(this,SdlControlActivity::class.java));finish()
+ }
+}
diff --git a/app/src/debug/java/com/andrerinas/openheadunit/sdl/SdlRelaySelfTestActivity.java b/app/src/debug/java/com/andrerinas/openheadunit/sdl/SdlRelaySelfTestActivity.java
