+package com.andrerinas.openheadunit.sdl;
+import android.graphics.*;
+import java.io.ByteArrayOutputStream;
+import com.smartdevicelink.proxy.SdlProxyALM;
+import com.smartdevicelink.proxy.RPCResponse;
+import com.smartdevicelink.proxy.rpc.*;
+import com.smartdevicelink.proxy.rpc.enums.*;
+import com.andrerinas.openheadunit.utils.AppLog;
+final class SdlAppIcon {
+    static void uploadIcon(SdlProxyALM proxy, DisplayCapabilities display) {
+        if(proxy==null || display==null)return;
+        final SdlProxyALM p=proxy;
+        try {
+            int w=64,h=64;
+            FileType type=FileType.GRAPHIC_PNG;
+            if(display.getImageFields()!=null)for(ImageField f:display.getImageFields()) {
+                if(f.getName()!=ImageFieldName.appIcon)continue;
+                if(f.getImageResolution()!=null) {w=f.getImageResolution().getResolutionWidth(); h=f.getImageResolution().getResolutionHeight();}
+                if(f.getImageTypeSupported()!=null && !f.getImageTypeSupported().contains(type)) {
+                    if(f.getImageTypeSupported().contains(FileType.GRAPHIC_JPEG)) type=FileType.GRAPHIC_JPEG;
+                    else if(f.getImageTypeSupported().contains(FileType.GRAPHIC_BMP)) type=FileType.GRAPHIC_BMP;
+                    else {log("ICON: central não anunciou PNG/JPEG/BMP para appIcon");return;}
+                }
+            }
+            if(w<1||h<1||w>1024||h>1024){log("ICON: dimensões inválidas "+w+"x"+h);return;}
+            Bitmap bitmap=Bitmap.createBitmap(w,h,Bitmap.Config.ARGB_8888);
+            Canvas canvas=new Canvas(bitmap);canvas.drawColor(Color.rgb(0,125,115));
+            Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG);paint.setColor(Color.WHITE);paint.setTextSize(Math.min(w,h)*0.38f);paint.setTextAlign(Paint.Align.CENTER);
+            canvas.drawText("AA",w/2f,h*0.64f,paint);
+            ByteArrayOutputStream bytes=new ByteArrayOutputStream();
+            if(type==FileType.GRAPHIC_BMP) {
+                int[] pixels=new int[w*h];bitmap.getPixels(pixels,0,w,0,0,w,h);
+                bytes.write(Bmp24.encode(w,h,pixels));
+            } else bitmap.compress(type==FileType.GRAPHIC_PNG?Bitmap.CompressFormat.PNG:Bitmap.CompressFormat.JPEG,95,bytes);
+            bitmap.recycle();
+            final String filename=type==FileType.GRAPHIC_BMP?"aa-sdl-bridge-icon.bmp":type==FileType.GRAPHIC_PNG?"aa-sdl-bridge-icon.png":"aa-sdl-bridge-icon.jpg";
+            PutFile file=new PutFile();file.setSdlFileName(filename);file.setFileType(type);file.setFileData(bytes.toByteArray());
+            file.setOnRPCResponseListener(new com.smartdevicelink.proxy.rpc.listeners.OnPutFileUpdateListener(){
+                public void onResponse(int id,RPCResponse response,long total){
+                    log("ICON PutFile="+response.toString());
+                    if(!Boolean.TRUE.equals(response.getSuccess()))return;
+                    SetAppIcon icon=new SetAppIcon();icon.setSdlFileName(filename);
+                    icon.setOnRPCResponseListener(new com.smartdevicelink.proxy.rpc.listeners.OnRPCResponseListener(){
+                        public void onResponse(int correlation,RPCResponse answer){log("ICON SetAppIcon="+answer.toString());}
+                    });
+                    try{p.sendRPCRequest(icon);}catch(Exception e){log("ICON SetAppIcon ERROR "+e);}
+                }
+            });
+            log("ICON upload "+w+"x"+h+" type="+type); p.sendRPCRequest(file);
+        }catch(Exception e){log("ICON ERROR "+e);}
+    }
+private static void log(String s){ AppLog.INSTANCE.i("SDL bridge: "+s); }
+}
