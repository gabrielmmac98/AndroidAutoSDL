--- /dev/null
+++ b/app/src/main/java/com/andrerinas/openheadunit/sdl/SdlPlaybackCoordinator.kt
@@ -0,0 +1,54 @@
+package com.andrerinas.openheadunit.sdl
+
+import android.content.Context
+import android.content.Intent
+import android.os.SystemClock
+import androidx.core.content.ContextCompat
+import com.andrerinas.openheadunit.App
+import com.andrerinas.openheadunit.aap.AapService
+import com.andrerinas.openheadunit.utils.AppLog
+
+internal object SdlPlaybackPolicy {
+    fun autoStart(enabled:Boolean, allowed:Boolean, connected:Boolean, starting:Boolean, stopped:Boolean, attempted:Boolean) =
+        enabled && allowed && !connected && !starting && !stopped && !attempted
+}
+
+object SdlPlaybackCoordinator {
+    @Volatile private var manuallyStopped=false
+    @Volatile private var autoAttempted=false
+    @Volatile private var startTime=0L
+    val starting:Boolean get() = startTime!=0L && SystemClock.elapsedRealtime()-startTime<20000
+    fun newConnection(){manuallyStopped=false;autoAttempted=false;startTime=0L}
+    fun maybeAutoStart(context:Context){
+        val app=App.provide(context)
+        val enabled=context.getSharedPreferences("sdl_projection",Context.MODE_PRIVATE).getBoolean("auto_video",false)
+        if(SdlPlaybackPolicy.autoStart(enabled,app.sdlBridge.isSessionAllowed,app.commManager.isConnected,starting,manuallyStopped,autoAttempted)) {
+            autoAttempted=true
+            start(context)
+        }
+    }
+    fun start(context:Context):Boolean {
+        val app=App.provide(context)
+        if(!app.sdlBridge.isSessionAllowed || app.commManager.isConnected || starting)return false
+        val prefs=context.getSharedPreferences("sdl_projection",Context.MODE_PRIVATE)
+        manuallyStopped=false
+        startTime=SystemClock.elapsedRealtime()
+        SdlSessionProfile.panelWidth=app.sdlBridge.panelWidth
+        SdlSessionProfile.panelHeight=app.sdlBridge.panelHeight
+        SdlSessionProfile.dpi=prefs.getInt("dpi",160).coerceIn(100,260)
+        SdlSessionProfile.aspectCorrectionE4=prefs.getInt("aspect_e4",10000).coerceIn(9000,11500)
+        SdlSessionProfile.active=true
+        app.sdlBridge.setArmed(true)
+        AppLog.i("SDL playback: start requested dpi=${SdlSessionProfile.dpi} aspect=${SdlSessionProfile.aspectCorrectionE4}")
+        ContextCompat.startForegroundService(context,Intent(context,AapService::class.java).setAction(AapService.ACTION_START_SELF_MODE))
+        return true
+    }
+    fun stop(context:Context){
+        manuallyStopped=true;autoAttempted=true;startTime=0L
+        val app=App.provide(context)
+        app.sdlBridge.setArmed(false)
+        app.commManager.disconnect()
+        ContextCompat.startForegroundService(context,Intent(context,AapService::class.java).setAction(AapService.ACTION_STOP_SELF_MODE))
+        AppLog.i("SDL playback: manual stop, AAP disconnected; automatic restart suppressed")
+    }
+}
