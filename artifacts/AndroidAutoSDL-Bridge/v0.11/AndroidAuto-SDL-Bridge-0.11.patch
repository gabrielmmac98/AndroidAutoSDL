+  String vs="attribute vec2 p; attribute vec2 uv; uniform mat4 tm; varying vec2 v; void main(){gl_Position=vec4(p,0.,1.); v=(tm*vec4(uv,0.,1.)).xy;}";
+  String fs="#extension GL_OES_EGL_image_external : require\nprecision mediump float; uniform samplerExternalOES image; varying vec2 v; void main(){gl_FragColor=texture2D(image,v);}";
