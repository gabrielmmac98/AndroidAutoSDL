+package com.andrerinas.openheadunit.sdl
+
+import com.andrerinas.openheadunit.aap.protocol.proto.Control
+
+/** Session-only geometry, never written to the normal Self Mode settings. */
+object SdlSessionProfile {
+    @Volatile var active = false
+    @Volatile var panelWidth = 800
+    @Volatile var panelHeight = 480
+    @Volatile var dpi = 160
+    @Volatile var aspectCorrectionE4 = 10000
+    val resolution: Control.Service.MediaSinkService.VideoConfiguration.VideoCodecResolutionType
+        get() = Control.Service.MediaSinkService.VideoConfiguration.VideoCodecResolutionType.values()
+            .firstOrNull { it.name == "_${panelWidth}x${panelHeight}" }
+            ?: Control.Service.MediaSinkService.VideoConfiguration.VideoCodecResolutionType._800x480
