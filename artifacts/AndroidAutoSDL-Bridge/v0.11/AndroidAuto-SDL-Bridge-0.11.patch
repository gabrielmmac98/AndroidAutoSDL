@@ -0,0 +1,10 @@
+package com.andrerinas.openheadunit.sdl;
+import android.app.Activity;import android.os.*;import android.media.*;import android.graphics.*;import android.view.Surface;import android.util.Log;
+public class SdlRelaySelfTestActivity extends Activity {
+ public void onCreate(Bundle b){super.onCreate(b);HandlerThread thread=new HandlerThread("RelaySelfTest");thread.start();Handler h=new Handler(thread.getLooper());h.post(()->{try{
+ MediaFormat f=MediaFormat.createVideoFormat("video/avc",800,480);f.setInteger(MediaFormat.KEY_COLOR_FORMAT,0x7f000789);f.setInteger(MediaFormat.KEY_BIT_RATE,1500000);f.setInteger(MediaFormat.KEY_FRAME_RATE,30);f.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL,1);
+ MediaCodec c=MediaCodec.createEncoderByType("video/avc");c.configure(f,null,null,MediaCodec.CONFIGURE_FLAG_ENCODE);Surface input=c.createInputSurface();c.start();final int[] packets={0},sent={0};MediaCodec.BufferInfo info=new MediaCodec.BufferInfo();Runnable drain=()->{int id;while((id=c.dequeueOutputBuffer(info,0))>=0){if(info.size>0)packets[0]++;c.releaseOutputBuffer(id,false);}};
+ SdlFrameRelay relay=new SdlFrameRelay(input,800,480,h,drain);relay.setInputSize(1080,1920);
+ Runnable tick=new Runnable(){public void run(){try{if(sent[0]<getIntent().getIntExtra("frames",45)){Canvas canvas=relay.surface().lockCanvas(null);canvas.drawColor(Color.rgb((sent[0]*5)%255,60,150));relay.surface().unlockCanvasAndPost(canvas);sent[0]++;h.postDelayed(this,33);}else{drain.run();Log.i("SDL_SELFTEST",packets[0]>10?"PASS frames="+sent[0]+" encodedPackets="+packets[0]:"FAIL encodedPackets="+packets[0]);relay.close();c.stop();c.release();input.release();thread.quitSafely();runOnUiThread(()->finish());}}catch(Exception e){Log.e("SDL_SELFTEST","FAIL tick",e);}}};h.post(tick);
+ }catch(Exception e){Log.e("SDL_SELFTEST","FAIL setup",e);}});}
+}
